{
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/tstrace",
    "packages/tstrace-vue"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -pit run build",
    "cli": "node packages/tstrace/bin/cli.js",
    "lint": "prettier --prose-wrap=always --write '*.md' && yarn workspace tstrace lint && yarn workspace tstrace-vue lint",
    "vue-build": "yarn workspace tstrace-vue build",
    "vue-dev": "yarn workspace tstrace-vue dev"
  },
  "dependencies": {
    "prettier": "^2.8.8"
  },
  "packageManager": "yarn@3.6.0"
}
